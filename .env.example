# Payload
PAYLOAD_SECRET=

# Postgres (matches docker-compose.yml defaults)
DATABASE_URI=postgresql://payload:payload@localhost:5432/ghl_payload_explorer

# GoHighLevel — Private Integration Token auth (GHL API v2)
# See README / setup walkthrough for exactly where to find these in your GHL sub-account.
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=

# GoHighLevel OAuth app (only needed if/when you move off the Private Integration Token)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=
